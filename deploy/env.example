# Copy to ../.env (next to compose.yaml) and fill in.
# deploy/setup-ubuntu.sh writes this file for you.

# A domain pointed at this server gets HTTPS automatically:
#   SITE_ADDRESS=gts.ehealthnigeria.org
# With no domain yet, use plain HTTP on the server IP (testing only):
SITE_ADDRESS=:80

# Login for the app. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the SINGLE quotes: the hash contains $ signs.
AUTH_USER=gts
AUTH_HASH='paste-hash-here'

# Largest upload in MB.
UPLOAD_MB=2000

# 1 on a machine with less than 4 GB RAM (lower map DPI, size warnings).
GTS_HOSTED=
